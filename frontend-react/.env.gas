# Build desplegable en Apps Script (HtmlService). HashRouter evita 404 al refrescar rutas.
VITE_ROUTER_MODE=hash

# Staging federativo real: JSON bootstrap + save/close + calendar sync GAS (Sheets/Drive reales).
VITE_ETR7_ACTA_PERSISTENCE=hybrid
VITE_ETR7_DEBUG=false

# Banner staging visible en Web App (omitir o false en build producción estable).
VITE_ETR7_STAGING=true
