# Perfil staging-gas: cargado solo con `npm run staging:gas` / `vite build --mode gas`.
# Abrir SIEMPRE desde la Web App Apps Script (google.script.run). NO usar `npm run dev` para staging.

# HashRouter evita 404 al refrescar rutas en HtmlService.
VITE_ROUTER_MODE=hash

# Encounter Workspace real: hydrate + save/close + calendar sync vía GAS/Drive.
VITE_ETR7_ACTA_PERSISTENCE=hybrid
VITE_ETR7_DEBUG=false

# Activa perfil [ENV] staging-gas + banner NO PRODUCCIÓN (omitir en build producción estable).
VITE_ETR7_STAGING=true
